// LinkMaker — Prisma 스키마(데이터베이스 설계도)
//
// [이 파일이 뭐야?] 우리 앱이 DB에 어떤 "표(table)"들을 만들지 정의하는 곳이다.
// 여기서 model 하나 = DB의 표 하나. 필드 하나 = 표의 열(column) 하나.
//
// [표들의 관계, 큰 그림]
//   User(작업공간)  ──< Link(짧은 링크)  ──< LinkEvent(클릭 1건 기록)
//        │                    └─ LinkImage(링크에 붙은 이미지, 1:1)
//        └──< Campaign(링크 묶음/캠페인)
//   Setting = 앱이 스스로 관리하는 설정값 저장소(비밀키 등).
//   ──< 표시는 "1 : 여러 개" 관계를 뜻한다(User 하나가 Link 여러 개를 가짐).
//
// [자주 나오는 문법]
//   @id = 기본 키(각 행을 구분하는 고유 번호)   @unique = 값이 중복되면 안 됨
//   @default(...) = 기본값   ? = 값이 없어도 됨(nullable)   @@index = 검색 속도용 색인
//   onDelete: Cascade = 부모가 삭제되면 자식도 함께 삭제

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // 사용하는 DB 종류
  url      = env("DATABASE_URL") // 접속 주소는 환경변수에서 읽음(비밀이라 코드에 안 씀)
}

/// Key/value store for server-managed configuration (e.g. auto-generated
/// signing secrets), so the app can run with only a database configured.
model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum LinkStatus {
  ACTIVE
  DISABLED
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
  UNKNOWN
}

enum ClickSource {
  LINK
  QR
}

// User = "작업공간(workspace)" 하나. 로그인은 없고, 브라우저마다 익명 작업공간을 갖는다.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  // Every workspace is anonymous (no login). It is identified by an
  // unguessable dashboard token: visiting /d/<token> opens its dashboard on
  // any device. isGuest is retained for compatibility and is always true.
  isGuest        Boolean  @default(true)
  dashboardToken String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  links        Link[]
  campaigns    Campaign[]

  @@map("users")
}

// Campaign = 링크들을 목적별로 묶는 그룹(예: "여름 이벤트"). 통계를 묶어 보기 좋게.
model Campaign {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[]

  @@unique([userId, name])
  @@index([userId])
  @@map("campaigns")
}

// Link = 짧은 링크 하나. slug(주소 끝부분)는 그대로 두고 destinationUrl(목적지)만
// 바꿔치기할 수 있는 게 핵심 — 그래서 링크를 수정해도 통계가 계속 이어진다.
model Link {
  id             String     @id @default(cuid())
  userId         String // 소유한 작업공간
  campaignId     String? // 속한 캠페인(없어도 됨)
  slug           String     @unique // 짧은 주소의 끝부분(고유)
  destinationUrl String // 실제로 이동할 목적지 주소
  title          String?
  description    String?
  status         LinkStatus @default(ACTIVE)
  expiresAt      DateTime?

  // Anonymous (no-account) links are owned by a system "public" user and are
  // managed via this unguessable token instead of a login session. Null for
  // links that belong to a real account.
  manageToken String? @unique

  // UTM parameters appended to the destination on redirect.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  image    LinkImage?
  events   LinkEvent[]

  @@index([userId])
  @@index([slug])
  @@index([userId, status])
  @@index([campaignId])
  @@map("links")
}

model LinkImage {
  id          String   @id @default(cuid())
  linkId      String   @unique
  url         String
  pathname    String? // storage pathname, used for deletion
  alt         String?
  width       Int?
  height      Int?
  sizeBytes   Int?
  contentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("link_images")
}

// LinkEvent = 클릭(또는 QR 스캔) "1건"의 기록. 링크가 클릭될 때마다 한 줄씩 쌓인다.
// 대시보드의 모든 통계는 이 표를 세고 묶어서 만든다.
model LinkEvent {
  id        String   @id @default(cuid())
  linkId    String // 어떤 링크의 클릭인지
  timestamp DateTime @default(now()) // 클릭 시각

  // 아래 세 값은 timestamp에서 미리 뽑아 저장해 둔 것. 매번 계산하지 않고 바로 묶어
  // 셀 수 있어 통계가 빨라진다(비정규화, denormalization).
  date      DateTime @db.Date
  hour      Int // 0-23 (UTC 기준 시)
  dayOfWeek Int // 0(일) ~ 6(토), UTC 기준

  // Referrer.
  referrer       String?
  referrerDomain String?

  // Client environment (best-effort, may be null).
  userAgent      String?
  browser        String?
  browserVersion String?
  engine         String? // browser engine, e.g. Blink / WebKit / Gecko
  os             String?
  osVersion      String?
  deviceType     DeviceType @default(UNKNOWN)
  deviceVendor   String? // e.g. Apple, Samsung
  deviceModel    String? // e.g. iPhone, SM-G991B
  cpuArch        String? // e.g. amd64, arm64
  isMobile       Boolean    @default(false)
  language       String?
  screenWidth    Int?
  screenHeight   Int?

  // Geo (coarse, from edge headers when available; never raw IP).
  country  String?
  region   String?
  city     String?
  timezone String?

  // UTM snapshot at click time.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Source + bot + privacy-preserving visitor id.
  source      ClickSource @default(LINK)
  isBot       Boolean     @default(false)
  botReason   String?
  visitorHash String? // daily-rotating salted hash, NOT an identifier we can reverse

  createdAt DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([timestamp])
  @@index([linkId, timestamp])
  @@index([country])
  @@index([deviceType])
  @@index([referrerDomain])
  @@index([linkId, isBot])
  @@index([visitorHash])
  @@map("link_events")
}
