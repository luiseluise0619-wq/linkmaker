// LinkMaker — Prisma schema
// Normalized schema for a link-management + analytics SaaS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LinkStatus {
  ACTIVE
  DISABLED
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
  UNKNOWN
}

enum ClickSource {
  LINK
  QR
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  links        Link[]
  campaigns    Campaign[]

  @@map("users")
}

model Campaign {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[]

  @@unique([userId, name])
  @@index([userId])
  @@map("campaigns")
}

model Link {
  id             String     @id @default(cuid())
  userId         String
  campaignId     String?
  slug           String     @unique
  destinationUrl String
  title          String?
  description    String?
  status         LinkStatus @default(ACTIVE)
  expiresAt      DateTime?

  // UTM parameters appended to the destination on redirect.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  image    LinkImage?
  events   LinkEvent[]

  @@index([userId])
  @@index([slug])
  @@index([userId, status])
  @@index([campaignId])
  @@map("links")
}

model LinkImage {
  id          String   @id @default(cuid())
  linkId      String   @unique
  url         String
  pathname    String? // storage pathname, used for deletion
  alt         String?
  width       Int?
  height      Int?
  sizeBytes   Int?
  contentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("link_images")
}

model LinkEvent {
  id        String   @id @default(cuid())
  linkId    String
  timestamp DateTime @default(now())

  // Denormalized time buckets for fast analytics grouping.
  date      DateTime @db.Date
  hour      Int // 0-23 (UTC)
  dayOfWeek Int // 0 (Sun) - 6 (Sat), UTC

  // Referrer.
  referrer       String?
  referrerDomain String?

  // Client environment (best-effort, may be null).
  userAgent      String?
  browser        String?
  browserVersion String?
  os             String?
  deviceType     DeviceType @default(UNKNOWN)
  isMobile       Boolean    @default(false)
  language       String?
  screenWidth    Int?
  screenHeight   Int?

  // Geo (coarse, from edge headers when available; never raw IP).
  country String?
  region  String?

  // UTM snapshot at click time.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Source + bot + privacy-preserving visitor id.
  source      ClickSource @default(LINK)
  isBot       Boolean     @default(false)
  botReason   String?
  visitorHash String? // daily-rotating salted hash, NOT an identifier we can reverse

  createdAt DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([timestamp])
  @@index([linkId, timestamp])
  @@index([country])
  @@index([deviceType])
  @@index([referrerDomain])
  @@index([linkId, isBot])
  @@index([visitorHash])
  @@map("link_events")
}
