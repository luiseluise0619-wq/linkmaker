# ---------------------------------------------------------------------------
# LinkMaker environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
#
# REQUIRED: only DATABASE_URL. Everything else is optional — the app
# auto-detects the URL on Vercel and auto-manages its signing secret + salt in
# the database when they aren't provided. Setting them explicitly is still
# recommended for production.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (REQUIRED).
# On Vercel, connect a Postgres store (Vercel Postgres / Neon / Supabase) and
# this is injected automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/linkmaker?schema=public"

# --- Everything below is OPTIONAL ---

# Public base URL, no trailing slash. If unset, the app uses the Vercel
# deployment domain automatically. Set it to your custom domain in production.
NEXT_PUBLIC_APP_URL=""

# Secret used to sign session JWTs. If unset, a strong secret is generated once
# and stored in the database. Set explicitly to control rotation.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Salt for privacy-preserving unique-visitor hashing. If unset, one is
# generated and stored in the database.
# Generate with: openssl rand -base64 32
ANALYTICS_SALT=""

# Vercel Blob storage token — required ONLY for image uploads.
BLOB_READ_WRITE_TOKEN=""

# Timezone used to display dashboard times, hours and day boundaries.
# Default is Korea (Asia/Seoul, KST). Use any IANA name, e.g. America/New_York.
DISPLAY_TIMEZONE="Asia/Seoul"

# Analytics data retention in days (default 365).
ANALYTICS_RETENTION_DAYS="365"

# Secret protecting the retention cron endpoint (recommended if you use it).
CRON_SECRET=""
