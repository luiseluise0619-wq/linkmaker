# ---------------------------------------------------------------------------
# LinkMaker environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# On Vercel, use Vercel Postgres / Neon / Supabase and paste the pooled URL.
DATABASE_URL="postgresql://user:password@localhost:5432/linkmaker?schema=public"

# Public base URL of the app (required). Used to build short URLs and QR codes.
# No trailing slash. In production set this to your real domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign session JWTs (required).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"

# Salt used when hashing visitor identifiers for privacy-preserving unique
# visitor estimation (required). Generate with: openssl rand -base64 32
ANALYTICS_SALT="replace-me-with-a-long-random-salt"

# Vercel Blob storage token (optional).
# Required only if you want image uploads for image links.
# Create in the Vercel dashboard -> Storage -> Blob. Server-side only.
BLOB_READ_WRITE_TOKEN=""

# Analytics data retention in days (optional, default 365).
# Events older than this can be pruned by the retention job.
ANALYTICS_RETENTION_DAYS="365"

# Secret protecting the retention cron endpoint (optional but recommended).
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
